<?xml version="1.0" encoding="utf-8"?>
<!--
  Wahlen 2027 – CasparCG für den oGraf-Rechner (DeckLink Duo 2, 1080i50 = EBU 1080i/25)

  Kanal 1  Hauptausgang  → Key + Fill an den Kayenne      (Renderer «haupt», Layer 10)
  Kanal 2  Videowand     → Fill an die Wand               (Renderer «wand», Layer 10)

  CasparCG spielt nur die Renderer-Seiten des Grafik-Servers ab. Was geladen wird, schickt der Grafik-Server
  selbst (Wächter, «PLAY 1-10 [HTML] …»). Hier also KEINE Vorlagen, keine Medien nötig.

  Desktop Video Setup (Blackmagic) vorher einstellen – siehe LIESMICH.md im selben Ordner:
    Variante A (empfohlen): Profil mit Anschlusspaaren («2 Sub-Devices / Dual Connector»)
      Gerät 1 = SDI 1+2, Gerät 2 = SDI 3+4. Die Karte gibt Key und Fill hardwareseitig synchron aus.
      Gemäss CasparCG-Doku liegt im Paarbetrieb der Fill auf dem höheren und der Key auf dem tieferen
      Anschluss (Gerät 2: Fill SDI 4, Key SDI 3) – beim ersten Test mit einem Testbild prüfen.
    Variante B: Profil mit vier Einzelgeräten («4 Sub-Devices, Half Duplex») – unten auskommentiert.

  Format: 1080i5000. Referenz (Black Burst / Tri-Level) an den REF-Eingang der Duo 2 – sonst rutscht der Key.
-->
<configuration>
  <paths>
    <media-path>media/</media-path>
    <log-path disable="false">log/</log-path>
    <data-path>data/</data-path>
    <template-path>template/</template-path>
  </paths>
  <lock-clear-phrase>wahlen2027</lock-clear-phrase>
  <log-level>info</log-level>

  <channels>
    <!-- ===== Kanal 1: Hauptausgang, Key + Fill an den Kayenne ===== -->
    <channel>
      <video-mode>1080i5000</video-mode>
      <consumers>
            <!-- Variante A: vier Einzelgeräte, Key über ein zweites Gerät -->
        <decklink>
          <device>1</device>
          <key-device>2</key-device>
          <keyer>external_separate_device</keyer>
          <key-only>false</key-only>
          <embedded-audio>false</embedded-audio>
          <latency>normal</latency>
          <buffer-depth>3</buffer-depth>
        </decklink>
        -->
      </consumers>
    </channel>

    <!-- ===== Kanal 2: Videowand, nur Fill ===== -->
    <channel>
      <video-mode>1080i5000</video-mode>
      <consumers>
        <!-- Variante A: Gerät 2 = SDI 3 + 4 (Fill auf SDI 4) -->
        <decklink>
          <device>2</device>
          <keyer>default</keyer>
          <embedded-audio>false</embedded-audio>
          <latency>normal</latency>
          <buffer-depth>3</buffer-depth>
        </decklink>
        <!-- Variante B: Gerät 3 = SDI 3 (SDI 4 frei, z. B. Rückweg/Eingang)
        <decklink>
          <device>3</device>
          <keyer>default</keyer>
          <embedded-audio>false</embedded-audio>
          <latency>normal</latency>
          <buffer-depth>3</buffer-depth>
        </decklink>
        -->
      </consumers>
    </channel>
  </channels>

  <controllers>
    <!-- AMCP: nur der Grafik-Server auf demselben Rechner spricht hier. Port 5250 in der Firewall NICHT öffnen. -->
    <tcp>
      <port>5250</port>
      <protocol>AMCP</protocol>
    </tcp>
  </controllers>

  <html>
    <!-- 0 = aus. Zur Fehlersuche z. B. 9222 setzen, dann im Chrome «chrome://inspect» auf diesem Rechner -->
    <remote-debugging-port>0</remote-debugging-port>
    <!-- GPU-Beschleunigung: erst nach stabilem Test ohne GPU einschalten -->
    <enable-gpu>true</enable-gpu>
  </html>
</configuration>
